<Window x:Class="SkinManager.Desktop.SkinMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="皮肤市场"
        Width="1000" Height="690" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}"
        Foreground="{StaticResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="MarketFilterStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="Transparent" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectedSurface}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource HoverSurface}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ImageButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ImageButtonSurface" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ImageButtonSurface" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarketCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="MarketExpanderStyle" TargetType="Expander"
               BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="皮肤市场" FontSize="28" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Content="刷新目录" HorizontalAlignment="Right"
                    Click="RefreshButton_Click" AutomationProperties.Name="刷新市场目录" />
        </Grid>

        <Grid x:Name="CatalogPane" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" MaxLength="200"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             AutomationProperties.Name="搜索市场皮肤" />
                    <TextBlock x:Name="SearchHint" Text="搜索皮肤名称或简介" FontSize="12"
                               Foreground="{StaticResource SecondaryText}" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAllButton" GroupName="AppearanceFilter" Content="全部" Tag=""
                                 IsChecked="True" Style="{StaticResource MarketFilterStyle}"
                                 Checked="AppearanceFilter_Checked" AutomationProperties.Name="全部外观" />
                    <RadioButton x:Name="FilterLightButton" GroupName="AppearanceFilter" Content="浅色" Tag="light"
                                 Style="{StaticResource MarketFilterStyle}" Checked="AppearanceFilter_Checked"
                                 AutomationProperties.Name="浅色外观" />
                    <RadioButton x:Name="FilterDarkButton" GroupName="AppearanceFilter" Content="深色" Tag="dark"
                                 Style="{StaticResource MarketFilterStyle}" Checked="AppearanceFilter_Checked"
                                 AutomationProperties.Name="深色外观" />
                </StackPanel>
                <Button x:Name="SearchButton" Grid.Column="4" Content="搜索" MinWidth="72"
                        Click="SearchButton_Click" AutomationProperties.Name="搜索市场目录" />
            </Grid>

            <ScrollViewer x:Name="CatalogScrollViewer" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl x:Name="CatalogCards" AutomationProperties.Name="市场皮肤卡片列表">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MarketCardStyle}" Loaded="MarketCard_Loaded">
                                <StackPanel>
                                    <Grid ToolTip="包内背景预览图。点击图片可查看完整的静态皮肤效果。">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource NoImageSurface}" CornerRadius="8"
                                                ClipToBounds="True">
                                                <Grid x:Name="PreviewFrame" Height="188" SizeChanged="PreviewFrame_SizeChanged">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock x:Name="PreviewPlaceholder" Text="{Binding PreviewLabel}"
                                                           FontSize="12" Foreground="{StaticResource SecondaryText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                                                           ToolTip="{Binding PreviewError}" />
                                                <Button x:Name="PreviewButton" Style="{StaticResource PreviewImageButtonStyle}"
                                                        Click="PreviewButton_Click" AutomationProperties.Name="打开皮肤效果预览"
                                                        ToolTip="点击查看静态皮肤效果预览" />
                                                <Button x:Name="RetryPreviewButton" Content="重试图片" Padding="12,7"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                                        Visibility="Collapsed" Click="RetryPreviewButton_Click"
                                                        ToolTip="{Binding PreviewError}" AutomationProperties.Name="重试预览图片" />
                                            </Grid>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="9"
                                                Padding="8,4" Background="{StaticResource OverlaySurface}" CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="背景预览" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="2,10,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MinWidth="0">
                                            <TextBlock Text="{Binding Name}" FontSize="17" Style="{StaticResource SectionTitle}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding SummaryLabel}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding InstallStatus}" FontSize="11"
                                                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <TextBlock Text="{Binding ShortDescription}" FontSize="12" Margin="2,7,2,0"
                                               Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                    <Expander Style="{StaticResource MarketExpanderStyle}">
                                        <Expander.Header>
                                            <TextBlock Text="查看详情" Foreground="{StaticResource SecondaryText}"
                                                       FontSize="12" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,2,0,6">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailMetadata}" Margin="0,7,0,0"
                                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="{Binding OperationStatus}" FontSize="11" Margin="2,4,2,0"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OperationIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar Height="4" Margin="2,5,2,0" Minimum="0" Maximum="100"
                                                 Value="{Binding DownloadProgress, Mode=OneWay}"
                                                 Visibility="{Binding ProgressVisibility}" />
                                    <Grid Margin="2,8,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding UpdatedLabel}" FontSize="11"
                                                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="DownloadButton" Grid.Column="1" Content="{Binding DownloadButtonText}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="110"
                                                IsEnabled="{Binding CanDownload}" Click="DownloadButton_Click"
                                                AutomationProperties.Name="下载并安装皮肤" />
                                        <Button x:Name="CancelDownloadButton" Grid.Column="3" Content="取消"
                                                Visibility="{Binding CancelVisibility}"
                                                Click="CancelDownloadButton_Click" AutomationProperties.Name="取消皮肤下载" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                    <Setter TargetName="PreviewPlaceholder" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPreviewError}" Value="True">
                                    <Setter TargetName="RetryPreviewButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PreviewPlaceholder" Property="Foreground" Value="{StaticResource ErrorText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="CatalogEmptyState" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" MaxWidth="300">
                <TextBlock x:Name="CatalogEmptyTitle" Text="正在读取市场目录" FontSize="15"
                           FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock x:Name="CatalogEmptyMessage" Text="请稍候。" FontSize="12"
                           Foreground="{StaticResource SecondaryText}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,7,0,12" />
                <Button x:Name="EmptyRetryButton" Content="重试" HorizontalAlignment="Center"
                        Visibility="Collapsed" Click="RefreshButton_Click" />
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CatalogCount" FontSize="12" Foreground="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="CatalogStatus" FontSize="12" Foreground="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="430" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageText" FontSize="12" Foreground="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="PreviousPageButton" Content="上一页" Padding="10,7" Margin="0,0,6,0"
                            Click="PreviousPageButton_Click" AutomationProperties.Name="上一页" />
                    <Button x:Name="NextPageButton" Content="下一页" Padding="10,7"
                            Click="NextPageButton_Click" AutomationProperties.Name="下一页" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PreviewPane" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackToCatalogButton" Content="返回市场" Padding="12,7"
                        Click="BackToCatalogButton_Click" AutomationProperties.Name="返回皮肤市场" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                <TextBlock x:Name="PreviewPageTitle" FontSize="21" Style="{StaticResource PageTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewPageSummary" FontSize="12" Foreground="{StaticResource SecondaryText}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="PreviewPageInstallState" Grid.Column="3" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelSurface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <ContentControl x:Name="PreviewBrowserHost" />
                    <StackPanel x:Name="PreviewStateOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="360" Margin="24" IsHitTestVisible="False">
                        <TextBlock x:Name="PreviewStateTitle" Text="正在读取皮肤预览…" FontSize="15"
                                   FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="PreviewStateDetail" Text="正在校验皮肤包并准备静态效果预览。"
                                   FontSize="12" Foreground="{StaticResource SecondaryText}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PreviewStatusText" FontSize="12" Foreground="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                <Button x:Name="PreviewRetryButton" Grid.Column="1" Content="重试预览"
                        Visibility="Collapsed" Click="PreviewRetryButton_Click"
                        AutomationProperties.Name="重试皮肤效果预览" />
                <Button x:Name="PreviewInstallButton" Grid.Column="3" Content="下载并安装"
                        Style="{StaticResource PrimaryButton}" MinWidth="124"
                        Click="PreviewInstallButton_Click" IsEnabled="False"
                        AutomationProperties.Name="下载并安装预览皮肤" />
            </Grid>
        </Grid>
    </Grid>
</Window>
