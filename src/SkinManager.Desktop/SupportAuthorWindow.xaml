<Window x:Class="SkinManager.Desktop.SupportAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持作者" Width="550" Height="330" MinWidth="520" MinHeight="310"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="感谢关注 SkinManager" FontSize="22" FontWeight="SemiBold"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="作者：Ancimen" FontSize="14" Margin="0,14,0,0" />
            <TextBlock x:Name="FreeDistributionText"
                       Text="本软件为免费无偿分发软件，若您为付费购买请举报售卖方并联系作者"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,14,0,0" />
            <TextBlock x:Name="SupportDirectionText"
                       Text="若您愿意支持作者，您可以点击“支持作者”前往赞助页"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel x:Name="ActionButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SupportAuthorLinkButton" Content="支持作者" Width="120" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}" Click="SupportAuthorLinkButton_Click" />
            <Button x:Name="CloseButton" Content="关闭" Width="90"
                    IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
