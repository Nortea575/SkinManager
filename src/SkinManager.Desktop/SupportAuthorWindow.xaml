<Window x:Class="SkinManager.Desktop.SupportAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkinManager.Desktop"
        Title="{local:Loc '支持作者'}" Width="620" Height="380" MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{local:Loc '感谢关注 SkinManager'}" FontSize="22" FontWeight="SemiBold"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="{local:Loc '作者：Ancimen'}" FontSize="14" Margin="0,14,0,0" />
            <TextBlock x:Name="GithubStarText"
                       Text="{local:Loc '感谢您使用SkinManager！若您愿意，希望您为Github仓库Star~💖'}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0" />
            <TextBlock x:Name="FreeDistributionText"
                       Text="{local:Loc '本软件为免费无偿分发软件，若您为付费购买请举报售卖方并联系作者'}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,14,0,0" />
            <TextBlock x:Name="SupportDirectionText"
                       Text="{local:Loc '若您愿意支持作者，您可以点击“支持作者”前往赞助页'}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel x:Name="ActionButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SupportAuthorLinkButton" Content="{local:Loc '支持作者'}" Width="120" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}" Click="SupportAuthorLinkButton_Click" />
            <Button x:Name="GitHubLinkButton" Padding="12,7"
                    AutomationProperties.Name="{local:Loc '打开 GitHub 仓库'}"
                    Click="GitHubLinkButton_Click" ToolTip="{local:Loc '打开 SkinManager GitHub 仓库'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Margin="0,0,7,0"
                          Data="M 8,0.7 L 9.9,5.4 L 15.2,5.8 L 11.1,9.2 L 12.5,14.8 L 8,11.8 L 3.5,14.8 L 4.9,9.2 L 0.8,5.8 L 6.1,5.4 Z"
                          Fill="Transparent" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" Stretch="Uniform" />
                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
