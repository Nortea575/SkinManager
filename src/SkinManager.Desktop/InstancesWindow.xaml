<Window x:Class="SkinManager.Desktop.InstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Codex 窗口" Width="920" Height="560" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}" Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Codex 实例" FontSize="24" Style="{StaticResource PageTitle}" />
            <TextBlock Text="普通和调试主实例会分别列出。选择调试实例只会设置连接目标；仍需返回主窗口点击“连接并应用 / 更新”。"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource PanelSurface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ListView x:Name="InstanceList" Margin="1" BorderThickness="0"
                          Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                          SelectionChanged="InstanceList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.Name="Codex 主实例列表">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="ToolTip" Value="{Binding ConnectionDetail}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="9,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border x:Name="RowSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <GridViewRowPresenter
                                                Content="{TemplateBinding Content}"
                                                Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedSurface}" />
                                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                                <Setter TargetName="RowSurface" Property="BorderThickness" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                                <Setter TargetName="RowSurface" Property="BorderThickness" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                            <Setter Property="Background" Value="{DynamicResource PanelSurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="9,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                        <Grid>
                                            <Border x:Name="HeaderSurface"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Margin="{TemplateBinding Padding}"
                                                    RecognizesAccessKey="True" />
                                            </Border>
                                            <Thumb x:Name="PART_HeaderGripper" Width="8"
                                                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                                   Background="Transparent" Cursor="SizeWE" Focusable="False">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="Transparent">
                                                            <Border x:Name="GripLine" Width="1" Margin="0,7"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{DynamicResource ControlLine}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource FocusAccent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource RaisedSurface}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                                <Setter TargetName="HeaderSurface" Property="BorderThickness" Value="0,0,0,2" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="窗口标题" Width="290" DisplayMemberBinding="{Binding WindowTitle}" />
                            <GridViewColumn Header="PID" Width="82" DisplayMemberBinding="{Binding ProcessId}" />
                            <GridViewColumn Header="类型" Width="88" DisplayMemberBinding="{Binding KindText}" />
                            <GridViewColumn Header="调试端口" Width="88" DisplayMemberBinding="{Binding PortText}" />
                            <GridViewColumn Header="连接状态" Width="105" DisplayMemberBinding="{Binding ConnectionText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                    <TextBlock x:Name="EmptyTitle" Text="没有找到 Codex 主实例" FontSize="15"
                               FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Text="点击刷新重新扫描。这里只显示 Codex 主窗口实例。"
                               FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActionStatus" Grid.Column="0" FontSize="12"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="刷新" Margin="0,0,6,0" Click="RefreshButton_Click" />
                <Button x:Name="LocateButton" Content="定位所选" Margin="0,0,6,0" Click="LocateButton_Click" />
                <Button x:Name="UseInstanceButton" Content="使用此实例" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,6,0" Click="UseInstanceButton_Click" />
                <Button x:Name="CloseInstanceButton" Content="退出所选实例" Style="{StaticResource DangerButton}"
                        Margin="0,0,6,0" Click="CloseInstanceButton_Click" />
                <Button x:Name="ForceCloseButton" Content="强制结束" Style="{StaticResource DangerButton}"
                        Margin="0,0,6,0" Visibility="Collapsed" Click="ForceCloseButton_Click" />
                <Button x:Name="DoneButton" Content="完成" IsCancel="True" Click="DoneButton_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
