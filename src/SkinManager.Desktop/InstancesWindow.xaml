<Window x:Class="SkinManager.Desktop.InstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 实例管理" Width="920" Height="560" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowSurface}"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerText}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
            <Setter Property="Background" Value="{StaticResource DangerSurface}" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Codex 实例" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="普通和调试主实例会分别列出。选择调试实例只会设置连接目标；仍需返回主窗口点击“连接并应用 / 更新”。"
                       FontSize="12" Foreground="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelSurface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <ListView x:Name="InstanceList" Margin="1" BorderThickness="0"
                          Background="Transparent" Foreground="{StaticResource PrimaryText}"
                          SelectionChanged="InstanceList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.Name="Codex 主实例列表">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="Background" Value="{StaticResource HoverSurface}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectedSurface}" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                            <Setter Property="Background" Value="{StaticResource SoftSurface}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,7" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="窗口标题" Width="290" DisplayMemberBinding="{Binding WindowTitle}" />
                            <GridViewColumn Header="PID" Width="82" DisplayMemberBinding="{Binding ProcessId}" />
                            <GridViewColumn Header="类型" Width="88" DisplayMemberBinding="{Binding KindText}" />
                            <GridViewColumn Header="调试端口" Width="88" DisplayMemberBinding="{Binding PortText}" />
                            <GridViewColumn Header="连接状态" Width="105" DisplayMemberBinding="{Binding ConnectionText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                    <TextBlock x:Name="EmptyTitle" Text="没有找到 Codex 主实例" FontSize="15"
                               FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Text="点击刷新重新扫描。这里只显示 Codex 主窗口实例。"
                               FontSize="12" Foreground="{StaticResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActionStatus" Grid.Column="0" FontSize="12"
                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="刷新" Margin="0,0,6,0" Click="RefreshButton_Click" />
                <Button x:Name="LocateButton" Content="定位所选" Margin="0,0,6,0" Click="LocateButton_Click" />
                <Button x:Name="UseInstanceButton" Content="使用此实例" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,6,0" Click="UseInstanceButton_Click" />
                <Button x:Name="CloseInstanceButton" Content="退出所选实例" Style="{StaticResource DangerButton}"
                        Margin="0,0,6,0" Click="CloseInstanceButton_Click" />
                <Button x:Name="ForceCloseButton" Content="强制结束" Style="{StaticResource DangerButton}"
                        Margin="0,0,6,0" Visibility="Collapsed" Click="ForceCloseButton_Click" />
                <Button x:Name="DoneButton" Content="完成" IsCancel="True" Click="DoneButton_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
