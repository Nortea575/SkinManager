<Window x:Class="SkinManager.Desktop.CompatibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magpie 启动方式" Width="760" Height="540" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}" Foreground="{StaticResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="CompatibilityWindow_PreviewKeyDown">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Magpie 启动方式" FontSize="25" Style="{StaticResource PageTitle}" />
            <TextBlock Text="核对 Magpie 自行重开 Codex 时是否会保留远程调试参数。"
                       FontSize="13" Foreground="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelSurface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="SupportIndicator" Width="10" Height="10" Margin="0,0,9,0"
                             Fill="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SupportTitle" Text="正在检查 Magpie…" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SupportSubtitle" Text="启动参数状态尚未读取。" FontSize="13"
                                   Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                        <TextBlock x:Name="MagpieRunningText" Text="运行状态：未知" FontSize="13"
                                   Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="CompatibilityMessageText" Grid.Row="6" FontSize="13"
                           TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Magpie 程序" FontSize="13" Foreground="{StaticResource SecondaryText}" />
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExecutablePathInput" Height="36" Padding="8,0"
                         VerticalContentAlignment="Center" ToolTip="选择已安装的 Magpie 可执行文件。" />
                <Button x:Name="ChooseExecutableButton" Grid.Column="1" Content="选择…" Padding="10,6"
                        Margin="8,0,0,0" Click="ChooseExecutableButton_Click" />
                <Button x:Name="InspectButton" Grid.Column="2" Content="重新检测" Padding="10,6"
                        Margin="6,0,0,0" Click="InspectButton_Click" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,4">
                <TextBlock Text="检测信息" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Text="版本：未检测" FontSize="13"
                           Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ExecutablePathText" Text="路径：未检测" FontSize="13"
                           Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="EvidenceText" Text="" FontSize="13"
                           Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="检测只读取 Magpie 程序信息与启动参数证据，不修改 Magpie 设置。"
                           FontSize="13" Foreground="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" Margin="0,12,0,4" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ActionStatusText" Grid.Row="8" Text="" FontSize="13"
                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaunchMagpieButton" Grid.Column="1" Content="启动 Magpie" Padding="12,7"
                    Margin="8,0,0,0" Click="LaunchMagpieButton_Click" />
            <Button x:Name="LaunchDebugCodexButton" Grid.Column="2" Content="从管理器启动调试版 Codex"
                    Padding="12,7" Margin="8,0,0,0" Click="LaunchDebugCodexButton_Click"
                    ToolTip="只启动调试版 Codex，不应用皮肤；普通实例仍在运行时会提示管理实例。" />
            <Button x:Name="CloseButton" Grid.Column="3" Content="关闭" Padding="12,7" Margin="8,0,0,0"
                    IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
