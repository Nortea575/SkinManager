<Window x:Class="SkinManager.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="760" Height="570" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}" Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="设置" FontSize="25" Style="{StaticResource PageTitle}" />
            <TextBlock Text="应用偏好和兼容性选项在此管理；界面语言在连接调试版 Codex 后生效。"
                       FontSize="13" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,4">
                <Border Background="{DynamicResource PanelSurface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="应用外观" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="仅切换管理器界面颜色，不改变皮肤内容。"
                                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,4,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="AppearanceModeBox" Grid.Column="1" Width="116"
                                  VerticalAlignment="Center" SelectionChanged="AppearanceModeBox_SelectionChanged"
                                  AutomationProperties.Name="应用外观">
                            <ComboBoxItem Content="夜间" Tag="Night" />
                            <ComboBoxItem Content="白昼" Tag="Day" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource PanelSurface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="开机启动" FontSize="17" FontWeight="SemiBold" />
                        <CheckBox x:Name="StartManagerAtLoginCheckBox" Content="管理器随 Windows 登录启动"
                                  IsThreeState="False" FontSize="14" Margin="0,12,0,0"
                                  Checked="StartupPreferenceCheckBox_Changed"
                                  Unchecked="StartupPreferenceCheckBox_Changed" />
                        <CheckBox x:Name="ApplyLastSelectedSkinCheckBox"
                                  Content="开机时启动并应用上次选择的皮肤（调试版）"
                                  IsThreeState="False" FontSize="14" Margin="24,8,0,0"
                                  Checked="StartupPreferenceCheckBox_Changed"
                                  Unchecked="StartupPreferenceCheckBox_Changed" />
                        <TextBlock Text="仅随 Windows 登录启动时执行；已打开普通版时会询问是否切换。"
                                   FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="48,5,0,0" />
                        <TextBlock x:Name="StartupPreferencesStatusText" Text="正在读取开机启动设置…"
                                   FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="24,8,0,0" />
                    </StackPanel>
                </Border>
                <Expander x:Name="CompatibilityGroupExpander" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock x:Name="CompatibilityGroupHeader" Text="兼容性"
                                   Foreground="{DynamicResource PrimaryText}" />
                    </Expander.Header>
                <StackPanel Margin="0,8,0,4">
                <Border Background="{DynamicResource PanelSurface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="界面语言" FontSize="17" FontWeight="SemiBold" />
                        <CheckBox x:Name="ForceSimplifiedChineseCheckBox" Content="固定使用简体中文"
                                  IsThreeState="False" FontSize="14" Margin="0,13,0,0"
                                  Checked="ForceSimplifiedChineseCheckBox_Changed"
                                  Unchecked="ForceSimplifiedChineseCheckBox_Changed" />
                        <TextBlock Text="连接调试版 Codex 后尝试使用 Codex 自带的简体中文界面。首次设定可能刷新页面；无法保证英文首屏完全消失。"
                                   FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="24,8,0,0" />
                        <Grid Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保存状态" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="LanguageSavedStatusText" Grid.Column="1" FontSize="13"
                                       Text="正在读取…" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="目标状态" FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="LanguageRuntimeStatusText" Grid.Row="2" Grid.Column="1"
                                       FontSize="13" Text="连接实例后生效" TextWrapping="Wrap"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <Button x:Name="RetrySettingsLoadButton" Content="重试读取" Padding="10,5"
                                HorizontalAlignment="Left" Margin="94,8,0,0"
                                Visibility="Collapsed" Click="RetrySettingsLoadButton_Click" />
                    </StackPanel>
                </Border>

                <Expander x:Name="MagpieSettingsExpander" Margin="0,12,0,0"
                          Expanded="MagpieSettingsExpander_Expanded">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Magpie 与 Codex 配置" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="检测配置和启动方式，管理 Magpie 程序。"
                                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="22,4,0,4">
                        <Border x:Name="CodexMagpieConfigPanel" Background="{DynamicResource PanelSurface}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Codex 配置文件状态" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="CodexConfigStatusText" Text="正在检测…"
                                           FontSize="13" Margin="0,6,0,0" />
                                <TextBlock x:Name="CodexConfigPathText" Text=""
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="Magpie 启动普通 Codex 时使用用户目录下的 .codex/config.toml（可在此文件设置网关模型）；从管理器启动的调试版也会沿用此配置。这里只检查文件是否存在且可读，不显示或修改配置内容。"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Button x:Name="InspectButton" Content="重新检测配置与 Magpie" Padding="10,5"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="InspectButton_Click" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelSurface}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SupportIndicator" Width="10" Height="10" Margin="0,0,9,0"
                                             Fill="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SupportTitle" Text="尚未检测" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SupportSubtitle" Text="展开时读取 Magpie 程序信息。" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="MagpieRunningText" Text="运行状态：未检测" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CompatibilityMessageText" Grid.Row="6" FontSize="13"
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Magpie 程序" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExecutablePathInput" Height="36" Padding="8,0"
                                     VerticalContentAlignment="Center" ToolTip="选择已安装的 Magpie 可执行文件。" />
                            <Button x:Name="ChooseExecutableButton" Grid.Column="1" Content="选择…" Padding="10,6"
                                    Margin="8,0,0,0" Click="ChooseExecutableButton_Click" />
                        </Grid>

                        <ScrollViewer x:Name="MagpieDetailsScrollViewer" MaxHeight="132" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,2">
                                <TextBlock Text="检测信息" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Text="版本：未检测" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ExecutablePathText" Text="路径：未检测" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="EvidenceText" Text="" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="从管理器启动可使用网关模型；Magpie 自身重新打开 Codex 时可能不保留调试参数。"
                                   FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="MagpieActionStatusText" Text="" FontSize="13"
                                   Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"
                                   MaxHeight="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button x:Name="LaunchMagpieButton" Content="启动 Magpie" Padding="12,7"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="LaunchMagpieButton_Click" />
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WindowStatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button x:Name="LaunchDebugCodexButton" Grid.Column="1" Content="启动 / 连接 Codex"
                    Padding="12,7" Margin="8,0,0,0" Click="LaunchDebugCodexButton_Click"
                    ToolTip="连接已有调试版目标，或启动新的调试版；按已保存设置同步界面语言，不应用皮肤。" />
            <Button x:Name="CloseButton" Grid.Column="2" Content="关闭" Padding="14,7" Margin="8,0,0,0"
                    IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
