<Window x:Class="SkinManager.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkinManager.Desktop"
        Title="{local:Loc '设置'}" Width="760" Height="570" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}" Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{local:Loc '设置'}" FontSize="25" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{local:Loc '管理 SkinManager 的语言、外观、启动和兼容性偏好。'}"
                       FontSize="13" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="2" KeyboardNavigation.TabNavigation="Once"
                    SelectionChanged="SettingsTabs_SelectionChanged"
                    BorderThickness="0" Background="Transparent" Padding="0"
                    ClipToBounds="False" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="15,8" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                    <Setter Property="Background" Value="{DynamicResource PanelSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}"
                                        Margin="0,0,6,0"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{DynamicResource SecondaryText}"
                                                      TextElement.FontWeight="Normal" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelSurface}" />
                                        <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground"
                                                Value="{DynamicResource PrimaryText}" />
                                        <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight"
                                                Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem x:Name="GeneralTab" Header="{local:Loc '常规'}" AutomationProperties.Name="{local:Loc '常规'}">
                <ScrollViewer Foreground="{DynamicResource PrimaryText}" FontWeight="Normal"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,8,8">
                        <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc '界面语言'}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Loc '只更改 SkinManager 界面，不改变 Codex 的语言。'}"
                                               FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                               Margin="0,4,14,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="176"
                                          VerticalAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged"
                                          AutomationProperties.Name="{local:Loc '界面语言'}">
                                    <ComboBoxItem Content="{local:Loc '跟随系统'}" Tag="System" />
                                    <ComboBoxItem Content="{local:Loc '简体中文'}" Tag="SimplifiedChinese" />
                                    <ComboBoxItem Content="English" Tag="English" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{local:Loc '开机启动'}" FontSize="17" FontWeight="SemiBold" />
                                <CheckBox x:Name="StartManagerAtLoginCheckBox"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                          FontSize="14" Margin="0,12,0,0"
                                          Checked="StartupPreferenceCheckBox_Changed"
                                          Unchecked="StartupPreferenceCheckBox_Changed">
                                    <TextBlock Text="{local:Loc '管理器随 Windows 登录启动'}" TextWrapping="Wrap"
                                               MaxWidth="440" />
                                </CheckBox>
                                <CheckBox x:Name="ApplyLastSelectedSkinCheckBox"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                          FontSize="14" Margin="24,8,0,0"
                                          Checked="StartupPreferenceCheckBox_Changed"
                                          Unchecked="StartupPreferenceCheckBox_Changed">
                                    <TextBlock Text="{local:Loc '开机时启动并应用上次选择的皮肤（调试版）'}"
                                               TextWrapping="Wrap"
                                               MaxWidth="440" />
                                </CheckBox>
                                <TextBlock Text="{local:Loc '仅随 Windows 登录启动时执行；已打开普通版时会询问是否切换。'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="48,5,0,0" />
                                <TextBlock x:Name="StartupPreferencesStatusText" Text="{local:Loc '正在读取开机启动设置…'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="24,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AppearanceTab" Header="{local:Loc '外观'}" AutomationProperties.Name="{local:Loc '外观'}">
                <ScrollViewer Foreground="{DynamicResource PrimaryText}" FontWeight="Normal"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,8,8">
                        <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc '应用外观'}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Loc '仅切换管理器界面颜色，不改变皮肤内容。'}"
                                               FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                               Margin="0,4,14,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="AppearanceModeBox" Grid.Column="1" Width="116"
                                          VerticalAlignment="Center" SelectionChanged="AppearanceModeBox_SelectionChanged"
                                          AutomationProperties.Name="{local:Loc '应用外观'}">
                                    <ComboBoxItem Content="{local:Loc '夜间'}" Tag="Night" />
                                    <ComboBoxItem Content="{local:Loc '白昼'}" Tag="Day" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CompatibilityTab" Header="{local:Loc '兼容性'}" AutomationProperties.Name="{local:Loc '兼容性'}">
                <ScrollViewer x:Name="SettingsScrollViewer" Foreground="{DynamicResource PrimaryText}"
                              FontWeight="Normal" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,8,8">
                        <Border x:Name="CodexMagpieConfigPanel" Background="{DynamicResource PanelSurface}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{local:Loc 'Magpie 与 Codex 配置'}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{local:Loc '检测配置文件状态和启动方式，并管理 Magpie 程序。'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="{local:Loc 'Codex 配置文件状态'}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock x:Name="CodexConfigStatusText" Text="{local:Loc '正在检测…'}"
                                           FontSize="13" Margin="0,6,0,0" />
                                <TextBlock x:Name="CodexConfigPathText" Text=""
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="{local:Loc 'Magpie 启动普通 Codex 时使用用户目录下的 .codex/config.toml（可在此文件设置网关模型）；从管理器启动的调试版也会沿用此配置。这里只检查文件是否存在且可读，不显示或修改配置内容。'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Button x:Name="InspectButton" Content="{local:Loc '重新检测配置与 Magpie'}" Padding="10,5"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="InspectButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SupportIndicator" Width="10" Height="10" Margin="0,0,9,0"
                                             Fill="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SupportTitle" Text="{local:Loc '尚未检测'}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SupportSubtitle" Text="{local:Loc '展开时读取 Magpie 程序信息。'}" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="MagpieRunningText" Text="{local:Loc '运行状态：未检测'}" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CompatibilityMessageText" Grid.Row="2" FontSize="13"
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock Text="{local:Loc 'Magpie 程序'}" Grid.Row="4" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" />
                                <Grid Grid.Row="6" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExecutablePathInput" Height="36" Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="{local:Loc '选择已安装的 Magpie 可执行文件。'}" />
                                    <Button x:Name="ChooseExecutableButton" Grid.Column="1" Content="{local:Loc '选择…'}"
                                            Padding="10,6" Margin="8,0,0,0" Click="ChooseExecutableButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="MagpieDetailsScrollViewer" MaxHeight="132" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,2">
                                <TextBlock Text="{local:Loc '检测信息'}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Text="{local:Loc '版本：未检测'}" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ExecutablePathText" Text="{local:Loc '路径：未检测'}" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="EvidenceText" Text="" FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="{local:Loc '从管理器启动可使用网关模型；Magpie 自身重新打开 Codex 时可能不保留调试参数。'}"
                                   FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="MagpieActionStatusText" Text="" FontSize="13"
                                   Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"
                                   MaxHeight="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button x:Name="LaunchMagpieButton" Content="{local:Loc '启动 Magpie'}" Padding="12,7"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="LaunchMagpieButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WindowStatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button x:Name="CloseButton" Grid.Column="1" Content="{local:Loc '关闭'}" Padding="14,7"
                    IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
