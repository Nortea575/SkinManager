<Window x:Class="SkinManager.Desktop.MarketAccountWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="皮肤市场账号" Width="920" Height="700" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}"
        FontFamily="{DynamicResource KlayBodyFont}" Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="皮肤市场账号" FontSize="22" Style="{StaticResource PageTitle}" />
                <TextBlock Text="使用与网站相同的账号；登录、注册与密码找回沿用网站流程。"
                           Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="返回市场" Padding="12,7"
                    Click="ReturnButton_Click" AutomationProperties.Name="返回皮肤市场" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelSurface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="AccountBrowser" />
        </Border>

        <TextBlock x:Name="AccountStatusText" Grid.Row="4" FontSize="12"
                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
