<UserControl x:Class="SkinManager.Desktop.SkinEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkinManager.Desktop"
             Background="{DynamicResource SidebarSurface}"
             Foreground="{DynamicResource PrimaryText}"
             FontFamily="{StaticResource KlayBodyFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingBrush x:Key="ColorCheckerboard" TileMode="Tile" Viewport="0,0,12,12"
                      ViewportUnits="Absolute" Viewbox="0,0,12,12" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource PanelSurface}" Geometry="M0,0 H12 V12 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource ControlLine}"
                                     Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ColorPickerAlphaSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderSurface" Height="24" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                    Background="{DynamicResource SoftSurface}"
                                    BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" />
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Margin="6,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                                        Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Width="16" Height="16" Focusable="False"
                                           AutomationProperties.Name="透明度滑块">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbOutline" Fill="{DynamicResource PanelSurface}"
                                                         Stroke="{DynamicResource FocusAccent}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbOutline" Property="Stroke" Value="{DynamicResource AccentHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbOutline" Property="Fill" Value="{DynamicResource Accent}" />
                                                        <Setter TargetName="ThumbOutline" Property="Stroke" Value="{DynamicResource PrimaryText}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                                        Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="9" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="新建皮肤" FontSize="20" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DirtyStateText" Text="草稿已保存" FontSize="11"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="撤销" Padding="8,5" MinHeight="30"
                        Click="UndoButton_Click" ToolTip="撤销上一步修改" />
                <Button x:Name="RedoButton" Content="重做" Padding="8,5" MinHeight="30"
                        Margin="5,0,0,0" Click="RedoButton_Click" ToolTip="重做已撤销的修改" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="EditorModeTabs" Grid.Row="2" BorderThickness="0" Background="Transparent"
                    SelectedIndex="0" SelectionChanged="EditorModeTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                    <Setter Property="Padding" Value="11,6" />
                    <Setter Property="Margin" Value="0,0,5,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SoftSurface}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource PanelSurface}" />
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ControlLine}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="创作">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <TextBlock Text="从素材开始" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="选择背景图片，或用纯色开始。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,8" />
                        <TextBlock x:Name="CreationBackgroundPathText" Text="可拖入 PNG、JPG 或 GIF，也可使用纯色背景"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="可拖入 PNG、JPG 或 GIF，也可使用纯色背景"
                                   Margin="0,0,0,6" />
                        <Border x:Name="BackgroundDropZone" Padding="8" Margin="0,0,0,7"
                                Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource ControlLine}"
                                BorderThickness="1" CornerRadius="8" AllowDrop="True"
                                DragOver="BackgroundDropZone_DragOver" Drop="BackgroundDropZone_Drop">
                            <TextBlock Text="拖放背景图片到这里" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="CreationChooseBackgroundButton" Content="选择图片" Padding="9,5"
                                    Click="ChooseBackgroundButton_Click" />
                        <Button x:Name="CreationUseColorButton" Content="使用纯色" Padding="9,5" Margin="5,0,0,0"
                                    Click="CreationUseColorButton_Click" />
                        </WrapPanel>
                        <Grid x:Name="CreationBackgroundColorPanel" Margin="0,0,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                            <TextBlock Text="纯色背景" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <DockPanel Grid.Row="1" Margin="0,3,0,0" LastChildFill="True">
                                <Button x:Name="CreationBackgroundPickerButton" Width="38" Padding="3" Margin="0,0,6,0"
                                        Click="CreationBackgroundPickerButton_Click" ToolTip="从色板选择背景色"
                                        AutomationProperties.Name="选择背景色">
                                    <Border x:Name="CreationBackgroundSwatch" Width="22" Height="22" CornerRadius="4"
                                            Background="#F7F9FC" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" />
                                </Button>
                                <TextBox x:Name="CreationBackgroundHexInput" VerticalContentAlignment="Center" Padding="8,0"
                                         TextChanged="CreationBackgroundHexInput_TextChanged"
                                         ToolTip="输入背景底色 HEX，例如 #F7F9FC" AutomationProperties.Name="背景色 HEX" />
                            </DockPanel>
                        </Grid>

                        <TextBlock Text="整体明暗" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        <ComboBox x:Name="CreationAppearanceInput" Margin="0,3,0,8"
                                  SelectionChanged="CreationAppearanceInput_SelectionChanged"
                                  AutomationProperties.Name="创作明暗">
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>

                        <TextBlock Text="主色" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        <DockPanel Margin="0,3,0,7" LastChildFill="True">
                            <Button x:Name="CreationAccentPickerButton" Width="38" Padding="3" Margin="0,0,6,0"
                                    Click="CreationAccentPickerButton_Click" ToolTip="从色板选择主色"
                                    AutomationProperties.Name="选择主色">
                                <Border x:Name="CreationAccentSwatch" Width="22" Height="22" CornerRadius="4"
                                        Background="#3B82F6" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" />
                            </Button>
                            <TextBox x:Name="CreationAccentHexInput" VerticalContentAlignment="Center" Padding="8,0"
                                     TextChanged="CreationAccentHexInput_TextChanged"
                                     ToolTip="输入十六进制颜色，例如 #3B82F6" AutomationProperties.Name="主色 HEX" />
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="面板透明度" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="PanelTransparencyValue" Grid.Column="1" Text="28%" FontSize="11"
                                       Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="PanelTransparencySlider" Minimum="0" Maximum="100" Value="28"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                ValueChanged="PanelTransparencySlider_ValueChanged"
                                PreviewMouseLeftButtonDown="CreationSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="CreationSlider_PreviewMouseLeftButtonUp"
                                PreviewKeyDown="CreationSlider_PreviewKeyDown" PreviewKeyUp="CreationSlider_PreviewKeyUp"
                                LostKeyboardFocus="CreationSlider_LostKeyboardFocus" LostMouseCapture="CreationSlider_LostMouseCapture"
                                AutomationProperties.Name="面板透明度" />

                        <Grid Margin="0,5,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="圆角" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="CornerRadiusValue" Grid.Column="1" Text="16 px" FontSize="11"
                                       Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" Value="16"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                ValueChanged="CornerRadiusSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="CreationSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="CreationSlider_PreviewMouseLeftButtonUp"
                                PreviewKeyDown="CreationSlider_PreviewKeyDown" PreviewKeyUp="CreationSlider_PreviewKeyUp"
                                LostKeyboardFocus="CreationSlider_LostKeyboardFocus" LostMouseCapture="CreationSlider_LostMouseCapture"
                                AutomationProperties.Name="圆角" />

                        <StackPanel x:Name="BackgroundTreatmentPanel">
                        <Grid Margin="0,5,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="背景明暗" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="BackgroundDarknessValue" Grid.Column="1" Text="8%" FontSize="11"
                                       Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="BackgroundDarknessSlider" Minimum="0" Maximum="100" Value="8"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                ValueChanged="BackgroundDarknessSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="CreationSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="CreationSlider_PreviewMouseLeftButtonUp"
                                PreviewKeyDown="CreationSlider_PreviewKeyDown" PreviewKeyUp="CreationSlider_PreviewKeyUp"
                                LostKeyboardFocus="CreationSlider_LostKeyboardFocus" LostMouseCapture="CreationSlider_LostMouseCapture"
                                AutomationProperties.Name="背景明暗" />
                        <TextBlock Text="增加遮罩后，背景更柔和，便于阅读。"
                                   FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,9" />
                        </StackPanel>
                        <StackPanel x:Name="BackgroundFocusPanel">
                        <CheckBox x:Name="BackgroundFocusModeCheckBox" Content="调整背景位置"
                                  Margin="0,5,0,0" Checked="BackgroundFocusModeCheckBox_Changed"
                                  Unchecked="BackgroundFocusModeCheckBox_Changed"
                                  AutomationProperties.Name="调整背景位置" />
                        <TextBlock Text="开启后拖动右侧预览调整焦点；关闭后可在精细编辑中点击组件。"
                                   FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="精细编辑">
                <Grid Margin="1,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="写入范围" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScopeInput" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="ScopeInput_SelectionChanged"
                                  ToolTip="元数据始终属于基础包；颜色、背景与组件覆盖写入当前范围">
                            <ComboBoxItem Content="基础 · 整体默认" Tag="base" />
                            <ComboBoxItem Content="浅色变体" Tag="light" />
                            <ComboBoxItem Content="深色变体" Tag="dark" />
                            <ComboBoxItem Content="首页场景" Tag="home" />
                            <ComboBoxItem Content="对话场景" Tag="conversation" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="下方修改写入所选范围；右侧预览切换仅用于查看。留空即可恢复跟随。"
                               FontSize="10" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />

        <TabControl x:Name="EditorTabs" Grid.Row="2" BorderThickness="0" Background="Transparent"
                    SelectionChanged="EditorTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                    <Setter Property="Padding" Value="11,6" />
                    <Setter Property="Margin" Value="0,0,5,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SoftSurface}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource PanelSurface}" />
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ControlLine}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="基础">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <Expander x:Name="MetadataExpander" IsExpanded="False" Margin="0,0,0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="皮肤信息" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}" />
                                    <TextBlock x:Name="MetadataSummary" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center" Margin="8,1,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock Text="ID" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                <TextBox x:Name="IdInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="版本" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                <TextBox x:Name="VersionInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="作者（可选）" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                <TextBox x:Name="AuthorInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="默认外观" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                <ComboBox x:Name="AppearanceInput" Margin="0,3,0,6" SelectedIndex="0"
                                          SelectionChanged="AppearanceInput_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="皮肤信息始终写入基础范围；下方样式写入所选范围。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="基础颜色" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="强调色、主背景和主要文字会直接影响整套配色。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="可输入 HEX 或令牌引用；留空会删除覆盖并恢复继承值。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl x:Name="TokenFields">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button x:Name="ColorPickerFieldButton" Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="FieldValueInput" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="支持 HEX 颜色、令牌引用或数值；留空删除覆盖并恢复继承值" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="背景">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <TextBlock Text="背景图片" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="BackgroundImagePathText" Text="未选择背景图"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="未选择背景图" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                            <Button Content="选择图片" Padding="10,6" Click="ChooseBackgroundButton_Click" />
                            <Button x:Name="RemoveBackgroundButton" Content="移除" Padding="10,6"
                                    Margin="6,0,0,0" Click="RemoveBackgroundButton_Click" />
                        </StackPanel>
                        <TextBlock Text="填充方式" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        <ComboBox x:Name="BackgroundFitInput" Margin="0,3,0,10" SelectionChanged="BackgroundFitInput_SelectionChanged">
                            <ComboBoxItem Content="继承基础设置" Tag="inherit" />
                            <ComboBoxItem Content="覆盖 · cover" Tag="cover" />
                            <ComboBoxItem Content="包含 · contain" Tag="contain" />
                        </ComboBox>
                        <TextBlock Text="图片位置与透明度" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock Text="透明度和焦点位置都使用 0% 到 100%。留空可恢复皮肤默认值。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl x:Name="BackgroundFields">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button x:Name="ColorPickerFieldButton" Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色"
                                                    Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="透明度和焦点位置使用 0% 到 100%；留空删除此覆盖" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ComponentsTab" Header="组件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <TextBlock Text="组件样式" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="可点击右侧本地预览中的组件，或从列表选择。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Text="可编辑项留空会删除该覆盖并恢复继承值；颜色支持 HEX 和令牌引用。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ComboBox x:Name="ComponentInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="window" SelectionChanged="ComponentInput_SelectionChanged" />
                        <TextBlock Text="状态" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,3" />
                        <ComboBox x:Name="ComponentStateInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedIndex="0" SelectionChanged="ComponentStateInput_SelectionChanged" />
                        <TextBlock x:Name="ComponentScopeHint" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="ComponentFields" Margin="0,12,0,3">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button x:Name="ColorPickerFieldButton" Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色"
                                                    Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="透明度使用 0% 到 100%；尺寸、字号、圆角和间距使用数字；留空删除覆盖" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ComboBox x:Name="AddComponentPropertyInput" DisplayMemberPath="Label"
                                      SelectedValuePath="Id" Width="176" />
                            <Button Content="添加" Padding="8,5" MinHeight="32" Margin="5,0,0,0"
                                    Click="AddComponentPropertyButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ValidationErrorText" Grid.Row="3" FontSize="11" Foreground="{DynamicResource ErrorText}"
                   TextWrapping="Wrap" MaxHeight="42" Visibility="Collapsed" />

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="7" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="皮肤名称" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="NameInput" MinHeight="34" Padding="8,5" VerticalContentAlignment="Center"
                         TextChanged="Metadata_TextChanged" AutomationProperties.Name="皮肤名称" />
            </DockPanel>
            <Grid x:Name="SaveActionsGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveAsButton" Grid.Column="0" Content="另存为" Padding="6,6" Click="SaveAsButton_Click" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Padding="6,6" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Grid.Column="4" Content="保存" Style="{StaticResource PrimaryButton}" Padding="6,6"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>

        <Popup x:Name="ColorPalettePopup" Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade" Closed="ColorPalettePopup_Closed">
            <Border x:Name="ColorPickerPopupSurface" Width="336" MaxHeight="560"
                    Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource ControlLine}"
                    BorderThickness="1" CornerRadius="9" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewKeyDown="ColorPalettePopup_PreviewKeyDown">
                    <StackPanel>
                        <TextBlock Text="选择颜色" FontSize="12" FontWeight="SemiBold" Margin="1,0,0,4" />
                        <local:ColorPickerControl x:Name="ColorPicker" Width="220" Height="220"
                                                  HorizontalAlignment="Center"
                                                  ColorChanged="ColorPicker_ColorChanged"
                                                  InteractionCompleted="ColorPicker_InteractionCompleted" />
                        <Grid Margin="0,1,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="原色" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="1,0,0,3" />
                                <Border Height="26" CornerRadius="4" Background="{DynamicResource ColorCheckerboard}"
                                        BorderBrush="{DynamicResource ControlLine}" BorderThickness="1">
                                    <Border x:Name="ColorPickerOriginalPreview" CornerRadius="4" Background="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="新色" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="1,0,0,3" />
                                <Border Height="26" CornerRadius="4" Background="{DynamicResource ColorCheckerboard}"
                                        BorderBrush="{DynamicResource ControlLine}" BorderThickness="1">
                                    <Border x:Name="ColorPickerNewPreview" CornerRadius="4" Background="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="HEX" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="1,0,0,2" />
                                <TextBox x:Name="PaletteHexInput" Text="#FFFFFF" Padding="6,3" MinHeight="28"
                                         VerticalContentAlignment="Center" TextChanged="PaletteHexInput_TextChanged"
                                         LostKeyboardFocus="PaletteColorInput_LostKeyboardFocus"
                                         AutomationProperties.Name="颜色 HEX" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RGB" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="1,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PaletteRedInput" Padding="5,3" MinHeight="28" VerticalContentAlignment="Center"
                                             TextChanged="PaletteRgbInput_TextChanged" LostKeyboardFocus="PaletteColorInput_LostKeyboardFocus"
                                             AutomationProperties.Name="红色通道" />
                                    <TextBox x:Name="PaletteGreenInput" Grid.Column="2" Padding="5,3" MinHeight="28" VerticalContentAlignment="Center"
                                             TextChanged="PaletteRgbInput_TextChanged" LostKeyboardFocus="PaletteColorInput_LostKeyboardFocus"
                                             AutomationProperties.Name="绿色通道" />
                                    <TextBox x:Name="PaletteBlueInput" Grid.Column="4" Padding="5,3" MinHeight="28" VerticalContentAlignment="Center"
                                             TextChanged="PaletteRgbInput_TextChanged" LostKeyboardFocus="PaletteColorInput_LostKeyboardFocus"
                                             AutomationProperties.Name="蓝色通道" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                            <TextBlock Text="透明度" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="1,0,8,0" />
                            <Slider x:Name="PaletteAlphaSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="255" Height="24"
                                    VerticalAlignment="Center" ValueChanged="PaletteAlphaSlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="PaletteAlphaSlider_MouseLeftButtonUp"
                                    PreviewKeyUp="PaletteAlphaSlider_KeyUp"
                                    Style="{StaticResource ColorPickerAlphaSliderStyle}"
                                    AutomationProperties.Name="颜色透明度" />
                            <TextBlock x:Name="PaletteAlphaValue" Grid.Column="2" Text="100%" FontSize="12"
                                       Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="PaletteCancelButton" Content="取消" Padding="8,5" Click="CancelPaletteButton_Click" />
                            <Button x:Name="PaletteConfirmButton" Grid.Column="2" Content="确定" Padding="8,5" Style="{StaticResource PrimaryButton}"
                                    Click="ConfirmPaletteButton_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
