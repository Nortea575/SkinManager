<UserControl x:Class="SkinManager.Desktop.SkinEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SidebarSurface}"
             Foreground="{StaticResource PrimaryText}"
             FontFamily="{StaticResource KlayBodyFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="9" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="7" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="新建皮肤" FontSize="20" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DirtyStateText" Text="草稿已保存" FontSize="11"
                           Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="撤销" Padding="8,5" MinHeight="30"
                        Click="UndoButton_Click" ToolTip="撤销上一步修改" />
                <Button x:Name="RedoButton" Content="重做" Padding="8,5" MinHeight="30"
                        Margin="5,0,0,0" Click="RedoButton_Click" ToolTip="重做已撤销的修改" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="1,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="编辑范围" FontSize="11"
                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <ComboBox x:Name="ScopeInput" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="ScopeInput_SelectionChanged"
                      ToolTip="元数据始终属于基础包；颜色、背景与组件覆盖写入所选范围">
                <ComboBoxItem Content="基础" Tag="base" />
                <ComboBoxItem Content="浅色变体" Tag="light" />
                <ComboBoxItem Content="深色变体" Tag="dark" />
                <ComboBoxItem Content="首页场景" Tag="home" />
                <ComboBoxItem Content="对话场景" Tag="conversation" />
            </ComboBox>
        </Grid>

        <TabControl x:Name="EditorTabs" Grid.Row="4" BorderThickness="0" Background="Transparent"
                    SelectionChanged="EditorTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                    <Setter Property="Padding" Value="11,6" />
                    <Setter Property="Margin" Value="0,0,5,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SoftSurface}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource PanelSurface}" />
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource ControlLine}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="基础">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <Expander x:Name="MetadataExpander" IsExpanded="False" Margin="0,0,0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="皮肤信息" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}" />
                                    <TextBlock x:Name="MetadataSummary" FontSize="11" Foreground="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center" Margin="8,1,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock Text="ID" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                <TextBox x:Name="IdInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="名称" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                <TextBox x:Name="NameInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="版本" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                <TextBox x:Name="VersionInput" Margin="0,3,0,8" TextChanged="Metadata_TextChanged" />
                                <TextBlock Text="默认外观" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                <ComboBox x:Name="AppearanceInput" Margin="0,3,0,6" SelectedIndex="0"
                                          SelectionChanged="AppearanceInput_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="皮肤信息始终写入基础范围；下方样式写入所选范围。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="基础颜色" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="强调色、主背景和主要文字会直接影响整套配色。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="可输入 HEX 或令牌引用；留空会删除覆盖并恢复继承值。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl x:Name="TokenFields">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{StaticResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="FieldValueInput" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="支持 HEX 颜色、令牌引用或数值；留空删除覆盖并恢复继承值" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="背景">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <TextBlock Text="背景图片" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="BackgroundImagePathText" Text="未选择背景图"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="未选择背景图" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                            <Button Content="选择图片" Padding="10,6" Click="ChooseBackgroundButton_Click" />
                            <Button x:Name="RemoveBackgroundButton" Content="移除" Padding="10,6"
                                    Margin="6,0,0,0" Click="RemoveBackgroundButton_Click" />
                        </StackPanel>
                        <TextBlock Text="填充方式" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        <ComboBox x:Name="BackgroundFitInput" Margin="0,3,0,10" SelectionChanged="BackgroundFitInput_SelectionChanged">
                            <ComboBoxItem Content="继承基础设置" Tag="inherit" />
                            <ComboBoxItem Content="覆盖 · cover" Tag="cover" />
                            <ComboBoxItem Content="包含 · contain" Tag="contain" />
                        </ComboBox>
                        <TextBlock Text="图片位置与透明度" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock Text="透明度和焦点位置都使用 0% 到 100%。留空可恢复皮肤默认值。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl x:Name="BackgroundFields">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色"
                                                    Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{StaticResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="透明度和焦点位置使用 0% 到 100%；留空删除此覆盖" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="组件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,10,5,8">
                        <TextBlock Text="组件样式" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="可点击右侧本地预览中的组件，或从列表选择。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Text="可编辑项留空会删除该覆盖并恢复继承值；颜色支持 HEX 和令牌引用。"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ComboBox x:Name="ComponentInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="window" SelectionChanged="ComponentInput_SelectionChanged" />
                        <TextBlock Text="状态" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,10,0,3" />
                        <ComboBox x:Name="ComponentStateInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedIndex="0" SelectionChanged="ComponentStateInput_SelectionChanged" />
                        <TextBlock x:Name="ComponentScopeHint" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="ComponentFields" Margin="0,12,0,3">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <Button Width="34" Padding="2" Margin="0,0,5,0" Tag="{Binding}"
                                                    Click="ColorPickerButton_Click" ToolTip="选择颜色"
                                                    Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="{Binding SwatchBrush}" BorderBrush="{StaticResource ControlLine}"
                                                        BorderThickness="1" />
                                            </Button>
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="8,0"
                                                         ToolTip="透明度使用 0% 到 100%；尺寸、字号、圆角和间距使用数字；留空删除覆盖" />
                                                <TextBlock x:Name="FieldPlaceholder" Text="{Binding Placeholder}" Margin="8,0,0,0"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ComboBox x:Name="AddComponentPropertyInput" DisplayMemberPath="Label"
                                      SelectedValuePath="Id" Width="176" />
                            <Button Content="添加" Padding="8,5" MinHeight="32" Margin="5,0,0,0"
                                    Click="AddComponentPropertyButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ValidationErrorText" Grid.Row="5" FontSize="11" Foreground="{StaticResource ErrorText}"
                   TextWrapping="Wrap" MaxHeight="42" Visibility="Collapsed" />

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveAsButton" Grid.Column="0" Content="另存为" Padding="6,6" Click="SaveAsButton_Click" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Padding="6,6" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Grid.Column="4" Content="保存" Style="{StaticResource PrimaryButton}" Padding="6,6"
                    Click="SaveButton_Click" />
        </Grid>

        <Popup x:Name="ColorPalettePopup" Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource ControlLine}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Width="230">
                <StackPanel>
                    <TextBlock Text="选择颜色" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <UniformGrid Columns="8" Margin="0,0,0,8">
                        <Button Tag="#202124" Click="PaletteColor_Click" Background="#202124" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#3B82F6" Click="PaletteColor_Click" Background="#3B82F6" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#14B8A6" Click="PaletteColor_Click" Background="#14B8A6" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#F97316" Click="PaletteColor_Click" Background="#F97316" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#EF4444" Click="PaletteColor_Click" Background="#EF4444" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#A855F7" Click="PaletteColor_Click" Background="#A855F7" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#EAB308" Click="PaletteColor_Click" Background="#EAB308" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#FFFFFF" Click="PaletteColor_Click" Background="#FFFFFF" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#111827" Click="PaletteColor_Click" Background="#111827" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#475569" Click="PaletteColor_Click" Background="#475569" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#64748B" Click="PaletteColor_Click" Background="#64748B" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#CBD5E1" Click="PaletteColor_Click" Background="#CBD5E1" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#E2E8F0" Click="PaletteColor_Click" Background="#E2E8F0" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#F1F5F9" Click="PaletteColor_Click" Background="#F1F5F9" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#DCFCE7" Click="PaletteColor_Click" Background="#DCFCE7" Height="25" Padding="0" Margin="1" />
                        <Button Tag="#FEE2E2" Click="PaletteColor_Click" Background="#FEE2E2" Height="25" Padding="0" Margin="1" />
                    </UniformGrid>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="应用" Padding="9,5" Margin="7,0,0,0"
                                Click="ApplyPaletteHexButton_Click" />
                        <TextBox x:Name="PaletteHexInput" Text="#FFFFFF" Padding="8,4"
                                 MinHeight="30" AutomationProperties.Name="十六进制颜色" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
