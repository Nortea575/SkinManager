<Window x:Class="SkinManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:desktop="clr-namespace:SkinManager.Desktop"
        xmlns:local="clr-namespace:SkinManager.Desktop"
        Title="{local:Loc 'ChatGPT 皮肤管理器'}"
        Width="1240" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}"
        Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="SkinListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTip" Value="{local:Loc '单击选择；拖动卡片可调整顺序'}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseEnter" Handler="SkinListItem_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="SkinListItem_MouseLeave" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SkinListItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="SkinListItem_PreviewMouseMove" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="7">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="DropMarker" Height="3" Margin="8,0"
                                    Background="{DynamicResource Accent}" CornerRadius="1.5"
                                    VerticalAlignment="Top" Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource ControlLine}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedSurface}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="4,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Icon}"
                       Width="28" Height="28"
                       Margin="0,0,9,0" Stretch="Uniform" />
                <TextBlock Text="{local:Loc 'SkinManager'}" FontSize="19" Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="AppVersionLabel" Text="" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" Margin="8,2,0,0" />
                <TextBlock x:Name="BusyText" Text="{local:Loc '正在导入皮肤…'}" FontSize="12"
                       Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="190"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="SupportAuthorButton" Margin="0,0,6,0" Padding="9,5"
                        Click="SupportAuthorButton_Click" ToolTip="{local:Loc '查看作者说明和支持方式进展。'}"
                        AutomationProperties.Name="{local:Loc '支持作者'}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,3 C10.2,3 8.8,4.4 8.8,6.1 C8.8,7 9.2,7.8 9.9,8.4 C7,8.9 5,11.1 5,13.8 C5,16.7 7.7,18.5 12,18.5 C16.3,18.5 19,16.7 19,13.8 C19,11.1 17,8.9 14.1,8.4 C14.8,7.8 15.2,7 15.2,6.1 C15.2,4.4 13.8,3 12,3 Z M10.2,13.1 C10.2,14.1 9.4,14.9 8.4,14.9 M13.8,13.1 C13.8,14.1 14.6,14.9 15.6,14.9"
                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.35"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="{local:Loc '支持作者'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MarketEntryButton" Margin="0,0,6,0" Padding="9,5"
                        Click="MarketEntryButton_Click"
                        ToolTip="{local:Loc '浏览、预览并下载市场皮肤。'}"
                        AutomationProperties.Name="{local:Loc '打开皮肤市场'}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,3 L4,3 L5,5 L17,5 L15.5,12 L7,12 L5,5 M8,15 A1.2,1.2 0 1 0 8,17.4 A1.2,1.2 0 1 0 8,15 M14,15 A1.2,1.2 0 1 0 14,17.4 A1.2,1.2 0 1 0 14,15"
                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.4" Fill="Transparent"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="{local:Loc '皮肤市场'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateEntryButton" Padding="9,5" MaxWidth="164"
                        Margin="0,0,6,0" Click="UpdateEntryButton_Click"
                        ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"
                        AutomationProperties.Name="{local:Loc '版本与更新'}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M3,7 A6,6 0 0 1 14,4 L16,6 M16,6 L16,2 M16,6 L12,6 M17,11 A6,6 0 0 1 6,14 L4,12 M4,12 L4,16 M4,12 L8,12"
                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock x:Name="UpdateEntryLabel" Grid.Column="2" Text="{local:Loc '版本与更新'}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Button>
                <Button x:Name="SettingsEntryButton" Margin="0,0,0,0" Padding="9,5"
                        Click="SettingsEntryButton_Click"
                        ToolTip="{local:Loc '管理应用设置与兼容性选项。'}"
                        AutomationProperties.Name="{local:Loc '设置'}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2 L20,5 V11 C20,16 16.5,19 12,21 C7.5,19 4,16 4,11 V5 Z M9,12 L11,14 L15,10"
                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="{local:Loc '设置'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <Border x:Name="LibraryWarning" Grid.Row="2" Margin="0,0,0,0" Padding="10,7"
                Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource WarningText}" BorderThickness="1"
                CornerRadius="8" Visibility="Collapsed">
            <TextBlock x:Name="LibraryWarningText" FontSize="12" Foreground="{DynamicResource WarningText}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceLeftColumn" Width="262" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LibraryBorder" Grid.Column="0" Background="{DynamicResource SidebarSurface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid x:Name="LibraryPanel" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="28">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="1,0,8,0" />
                            <TextBlock Text="{local:Loc '皮肤库'}" FontSize="16" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="SkinCountText" Text="{local:Loc '本地皮肤'}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2" Height="36">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="{local:Loc '搜索皮肤'}" />
                        <TextBlock x:Name="SearchHint" Text="{local:Loc '搜索名称或 ID'}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="SortStatusText" Grid.Row="3" Text="{local:Loc '拖动皮肤卡片调整顺序（单击选择）'}" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="2,3,0,5"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="4">
                        <ListBox x:Name="SkinList" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource PrimaryText}"
                                 Padding="0" ItemContainerStyle="{StaticResource SkinListItemStyle}"
                                 SelectionChanged="SkinList_SelectionChanged"
                                 AllowDrop="True" DragOver="SkinList_DragOver" Drop="SkinList_Drop"
                                 DragLeave="SkinList_DragLeave"
                                 Tag="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.Name="{local:Loc '皮肤列表'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="60" Height="46" CornerRadius="7"
                                                Background="{DynamicResource NoImageSurface}" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="ThumbnailImage" Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill" />
                                                <TextBlock x:Name="ThumbnailPlaceholder" Text="{local:Loc '无背景图'}" Visibility="Collapsed"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Text="{Binding Entry.Name}" FontSize="13"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Entry.Name}" />
                                            <TextBlock Text="{Binding Entry.Id}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Entry.Id}" />
                                            <TextBlock x:Name="RowAppearanceLabel" Text="{Binding AppearanceLabel}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter TargetName="ThumbnailImage" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ThumbnailPlaceholder" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ListEmptyState" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="8" MaxWidth="230">
                            <TextBlock x:Name="ListEmptyTitle" Text="{local:Loc '暂无本地皮肤'}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}" TextAlignment="Center" />
                            <TextBlock x:Name="ListEmptyText" Text="{local:Loc '从市场浏览并下载皮肤，或导入 ZIP 包和皮肤文件夹。'}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,12" />
                            <Button x:Name="ListEmptyMarketButton" Content="{local:Loc '浏览皮肤市场'}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                    Margin="0,0,0,6" Click="MarketEntryButton_Click" />
                            <Button x:Name="ListEmptyImportButton" Content="{local:Loc '导入皮肤'}"
                                    HorizontalAlignment="Center" Click="ImportButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewSkinButton" Grid.Column="0" Content="{local:Loc '新建皮肤'}"
                                Click="NewSkinButton_Click" AutomationProperties.Name="{local:Loc '新建皮肤'}" />
                        <Button x:Name="ImportButton" Grid.Column="2" Content="{local:Loc '导入皮肤'}"
                                Style="{StaticResource PrimaryButton}" Click="ImportButton_Click"
                                AutomationProperties.Name="{local:Loc '导入皮肤'}" />
                    </Grid>
                </Grid>
                </Grid>
            </Border>

            <Border x:Name="EditorPanel" Grid.Column="0" Background="{DynamicResource SidebarSurface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                    Visibility="Collapsed">
                <desktop:SkinEditorView x:Name="SkinEditor" Visibility="Collapsed" />
            </Border>

            <Grid x:Name="MainContentGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="DetailsEmptyState" Grid.Row="0" Background="Transparent"
                        BorderThickness="0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="24">
                            <TextBlock x:Name="DetailsEmptyTitle" Text="{local:Loc '还没有可预览的皮肤'}" FontSize="25"
                                   Style="{StaticResource PageTitle}" TextAlignment="Center" />
                        <TextBlock x:Name="DetailsEmptyMessage" Text="{local:Loc '浏览市场皮肤或导入本地皮肤包，查看背景图、配色和聊天布局预览。'}"
                                   FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,14" />
                        <Button Content="{local:Loc '打开皮肤市场'}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Margin="0,0,0,6" Click="MarketEntryButton_Click" />
                        <Button Content="{local:Loc '导入皮肤'}" HorizontalAlignment="Center" Click="ImportButton_Click" />
                    </StackPanel>
                </Border>

                <Grid x:Name="DetailsScroll" Grid.Row="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="PreviewRow" Height="*" MinHeight="130" />
                    <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="SelectedSummary" Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" MinWidth="0">
                    <TextBlock x:Name="SelectedName" FontSize="30" Style="{StaticResource PageTitle}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="SelectedId" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="EditSkinButton" Content="{local:Loc '编辑'}" Margin="0,0,5,0" Padding="9,5"
                                    Click="EditSkinButton_Click" AutomationProperties.Name="{local:Loc '编辑皮肤'}" />
                            <Button x:Name="OriginalButton" Content="{local:Loc '原图'}" Margin="0,0,5,0" Padding="9,5"
                                    Click="OriginalButton_Click" ToolTip="{local:Loc '查看原始背景图'}" />
                            <Button x:Name="MoreActionsButton" Content="{local:Loc '更多'}" Padding="9,5"
                                    Click="MoreActionsButton_Click"
                                    ToolTip="{local:Loc '导出或删除当前皮肤'}">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="MoreActionsContextMenu_Opened">
                        <MenuItem x:Name="CreateCopyMenuItem" Header="{local:Loc '以此为基础创建'}" Click="CreateCopyButton_Click" />
                        <Separator />
                                        <MenuItem x:Name="ExportMenuItem" Header="{local:Loc '导出皮肤…'}" Click="ExportButton_Click" />
                                        <Separator />
                                        <MenuItem x:Name="DeleteMenuItem" Header="{local:Loc '删除皮肤…'}" Tag="Danger"
                                                  Click="DeleteButton_Click"
                                                  Foreground="{DynamicResource DangerText}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="PreviewSettingsExpander" Grid.Row="1" IsExpanded="False"
                              Margin="0,0,0,7">
                        <Expander.Header>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc '预览选项'}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" MinWidth="0"
                                           Text="{local:Loc '外观、场景、侧栏和原版对照只影响预览；透明度也会用于下一次应用。'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                        </Expander.Header>
                        <Border Margin="0,5,0,0" Padding="0"
                                Background="Transparent" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{local:Loc '场景、外观、侧栏与原版对照只用于预览；透明度会同步用于下一次皮肤应用。'}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,0,0,6" TextWrapping="Wrap" />
                            <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc '场景'}" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="PreviewSceneBox" Width="96" SelectedIndex="0"
                                          SelectionChanged="PreviewOptions_SelectionChanged" AutomationProperties.Name="{local:Loc '预览页面'}">
                                    <ComboBoxItem Content="{local:Loc '首页'}" Tag="home" />
                                    <ComboBoxItem Content="{local:Loc '对话'}" Tag="conversation" />
                                </ComboBox>
                                <TextBlock Text="{local:Loc '外观'}" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox x:Name="PreviewAppearanceBox" Width="112" Margin="0,0,10,0"
                                          SelectedIndex="0" SelectionChanged="PreviewOptions_SelectionChanged"
                                          AutomationProperties.Name="{local:Loc '预览明暗'}">
                                    <ComboBoxItem Content="{local:Loc '跟随皮肤'}" Tag="skin" />
                                    <ComboBoxItem Content="{local:Loc '浅色'}" Tag="light" />
                                    <ComboBoxItem Content="{local:Loc '深色'}" Tag="dark" />
                                    <ComboBoxItem Content="{local:Loc '跟随系统'}" Tag="system" />
                                </ComboBox>
                                <CheckBox x:Name="PreviewSidebarCheckBox" Content="{local:Loc '侧栏'}" IsChecked="True"
                                          Margin="0,0,12,0" VerticalAlignment="Center"
                                          Checked="PreviewOptions_ToggleChanged" Unchecked="PreviewOptions_ToggleChanged"
                                          AutomationProperties.Name="{local:Loc '显示侧栏'}" />
                                <CheckBox x:Name="PreviewOriginalBaseCheckBox" Content="{local:Loc '原版对照'}"
                                          VerticalAlignment="Center" Checked="PreviewOptions_ToggleChanged"
                                          Unchecked="PreviewOptions_ToggleChanged" AutomationProperties.Name="{local:Loc '原版对照'}" />
                            </WrapPanel>
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc '应用透明度'}" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <CheckBox x:Name="PreviewTransparencyFollowCheckBox" Content="{local:Loc '跟随主题'}" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,7,0"
                                          Checked="PreviewOptions_ToggleChanged" Unchecked="PreviewOptions_ToggleChanged"
                                          AutomationProperties.Name="{local:Loc '面板透明度跟随主题'}" />
                                <TextBox x:Name="PreviewTransparencyInput" Text="{local:Loc '30'}" Width="50" Height="32"
                                         Padding="6,0" TextAlignment="Right" IsEnabled="False"
                                         LostKeyboardFocus="PreviewTransparencyInput_LostKeyboardFocus"
                                         PreviewKeyDown="PreviewTransparencyInput_KeyDown"
                                         TextChanged="PreviewTransparencyInput_TextChanged"
                                         ToolTip="{local:Loc '输入 0 到 100 的整数；不改变壁纸或遮罩。0% 不透明，100% 全透明。'}"
                                         AutomationProperties.Name="{local:Loc '面板透明度百分比'}" />
                                <TextBlock Text="{local:Loc '%'}" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="4,0,8,0" />
                                <TextBlock x:Name="PreviewTransparencyValue" Text="{local:Loc '主题值'}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewTransparencyError" FontSize="12" Foreground="{DynamicResource ErrorText}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                           AutomationProperties.Name="{local:Loc '面板透明度输入错误'}" />
                            </WrapPanel>
                        </Grid>
                        </Border>
                    </Expander>

                    <Grid x:Name="PreviewActiveHeader" Grid.Row="2" Margin="1,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewHeading" Text="{local:Loc '预览'}" FontSize="16" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewStatus" Grid.Column="1" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="10,0,8,0" Visibility="Visible"
                                   AutomationProperties.Name="{local:Loc '预览状态'}" />
                        <TextBlock x:Name="PreviewBaseVersion" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="185" Margin="6,0,8,0"
                                   ToolTip="{local:Loc '依据本地原生静态样板构建的结构预览，不是当前运行的真实客户端截图。'}" />
                        <Button x:Name="PreviewPowerButton" Grid.Column="3" Content="{local:Loc '关闭预览'}"
                                HorizontalAlignment="Right" Padding="8,4" MinHeight="30"
                                Click="PreviewPowerButton_Click" ToolTip="{local:Loc '释放本地预览浏览器内存'}" />
                    </Grid>
                    <Grid x:Name="PreviewClosedHeader" Grid.Row="2" Visibility="Collapsed"
                          Margin="1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Loc '本地预览已关闭'}" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="PreviewReopenButton" Grid.Column="1" Content="{local:Loc '重新打开预览'}" Padding="9,4"
                                Click="PreviewPowerButton_Click" AutomationProperties.Name="{local:Loc '重新打开预览'}" />
                    </Grid>

                    <Border x:Name="PreviewContainer" Grid.Row="3"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                            Background="{DynamicResource PanelSurface}" ClipToBounds="True">
                        <Grid x:Name="PreviewViewport" MinHeight="130" ClipToBounds="True"
                              Background="{DynamicResource PanelSurface}" SizeChanged="PreviewViewport_SizeChanged"
                              AutomationProperties.Name="{local:Loc '皮肤实时预览视口'}">
                            <Grid x:Name="PreviewBrowserHost">
                                <wv2:WebView2 x:Name="PreviewBrowser" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" Visibility="Collapsed" />
                            </Grid>
                            <Grid x:Name="OriginalImageLayer" Visibility="Collapsed" Background="{DynamicResource PanelSurface}">
                                <Image x:Name="OriginalImageSource" Stretch="Uniform" Margin="12" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,3,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="SelectedMetadata" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Loc '皮肤信息'}" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="SelectedAppearance" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedImageDimensions" FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{local:Loc '背景图片像素尺寸；未提供背景图时显示“无背景图”'}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ColorSection" Grid.Row="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Loc '配色'}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ScrollViewer x:Name="ColorItemsScrollViewer" Grid.Column="1"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Top" MaxHeight="64" MinWidth="0"
                                          AutomationProperties.Name="{local:Loc '皮肤配色'}">
                                <ItemsControl x:Name="ColorItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="112" Height="34" Margin="0,0,6,5" Padding="5,3"
                                                    CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    Background="{DynamicResource PanelSurface}" ToolTip="{Binding RawName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="RuntimeControlsBorder" Grid.Row="1" Margin="0,8,0,0" Padding="12,9"
                        Background="{DynamicResource SoftSurface}" BorderThickness="0" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc '连接与应用'}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="RuntimeSelectedSkinText" Grid.Column="1"
                                           Text="{local:Loc '先选择要应用的皮肤'}" FontSize="14" FontWeight="SemiBold"
                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,3,0,0" MinWidth="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc '目标窗口'}" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="RuntimeTargetText" Grid.Column="1" Text="{local:Loc '自动查找调试版'}"
                                           FontSize="13" MinWidth="0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{local:Loc '自动查找当前可用的 Codex 调试版；也可在“选择窗口”中选择。'}" />
                                <TextBlock x:Name="RuntimeConnectedTargetLabel" Grid.Column="2" Text="{local:Loc '当前连接'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBlock x:Name="RuntimeConnectedTargetText" Grid.Column="3" Text="{local:Loc '未连接'}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip="{local:Loc '当前皮肤管理器连接到的 Codex 实例。'}"
                                           AutomationProperties.Name="{local:Loc '当前连接的桌面应用实例'}" />
                            </Grid>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                <Button x:Name="SelectRuntimeTargetButton" Content="{local:Loc '选择窗口'}" Padding="10,6"
                                        Margin="0,0,6,0" Click="SelectRuntimeTargetButton_Click"
                                        ToolTip="{local:Loc '查看正在运行的 Codex 实例并选择连接目标。'}" />
                                <Button x:Name="ApplyRuntimeButton" Style="{StaticResource PrimaryButton}"
                                        MinWidth="132" Padding="12,7" Click="ApplyRuntimeButton_Click"
                                        AutomationProperties.Name="{local:Loc '启动并应用或更新皮肤'}">
                                    <TextBlock x:Name="RuntimePrimaryActionText" Text="{local:Loc '启动并应用'}" />
                                </Button>
                                <Button x:Name="RemoveRuntimeButton" Content="{local:Loc '恢复原生'}" Margin="6,0,0,0"
                                        Padding="10,6" Click="RemoveRuntimeButton_Click"
                                        AutomationProperties.Name="{local:Loc '恢复原生外观'}"
                                        ToolTip="{local:Loc '只移除皮肤外观，并恢复原生页面。'}" />
                                <Button x:Name="CancelRuntimeActionButton" Content="{local:Loc '取消操作'}" Margin="6,0,0,0"
                                        Padding="10,6" Visibility="Collapsed"
                                        Click="CancelRuntimeActionButton_Click" />
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RuntimeStatusIndicator" Width="8" Height="8"
                                     Grid.Column="0" Fill="{DynamicResource SecondaryText}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="RuntimeStatusText" Grid.Column="1" Text="{local:Loc '未连接'}" FontSize="13"
                                       FontWeight="SemiBold" Margin="7,0,10,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="{local:Loc '桌面应用连接与应用状态'}" />
                            <TextBlock x:Name="RuntimeStatusMessage" Grid.Column="2"
                                       Text="{local:Loc '选择皮肤并选择 Codex 窗口，或在没有实例时启动调试版。'}"
                                       FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       ToolTip="{local:Loc '选择皮肤并选择 Codex 窗口，或在没有实例时启动调试版。'}" />
                        </Grid>
                        <Expander x:Name="AdvancedSettingsExpander" Grid.Row="2" Header="{local:Loc '高级设置'}"
                                  IsExpanded="False" Margin="0,3,0,0">
                            <WrapPanel Margin="0,7,0,2" VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc '端口'}" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="RuntimePortInput" Text="{local:Loc '9335'}" Width="72" Height="34"
                                         Padding="6,0" TextAlignment="Right" MaxLength="5"
                                         ToolTip="{local:Loc '仅在需要手动指定循环地址调试端口时修改。默认9335。'}"
                                         AutomationProperties.Name="{local:Loc '桌面应用连接端口'}"
                                         TextChanged="RuntimePortInput_TextChanged" />
                                <Button x:Name="LaunchDebugButton" Content="{local:Loc '只启动调试版'}" Margin="8,0,6,0"
                                        Padding="10,6" Click="LaunchDebugButton_Click"
                                        ToolTip="{local:Loc '启动并核验调试版目标；不应用皮肤，也不会关闭或重启已运行的应用。'}" />
                                <Button x:Name="LocateConnectedWindowButton" Content="{local:Loc '定位已连接窗口'}"
                                        Padding="10,6" Click="LocateConnectedWindowButton_Click"
                                        ToolTip="{local:Loc '按当前连接的进程身份定位窗口。'}" />
                            </WrapPanel>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
