<Window x:Class="SkinManager.Desktop.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本与更新" Width="580" Height="650" MinWidth="500" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowSurface}"
        FontFamily="{StaticResource KlayBodyFont}"
        Foreground="{StaticResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="ViewTabStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource KlayBodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentForeground}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FocusAccent}" />
                                <Setter TargetName="TabSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="11" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="版本与更新" FontSize="24" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CurrentVersionText" Margin="0,5,0,0" FontSize="12"
                       Foreground="{StaticResource SecondaryText}" />
            <TextBlock x:Name="ChannelText" Margin="0,3,0,0" FontSize="12"
                       Foreground="{StaticResource SecondaryText}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelSurface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="CheckUpdatesTab" GroupName="UpdatesView" Content="检查更新"
                             IsChecked="True" Style="{StaticResource ViewTabStyle}"
                             Checked="ViewTab_Checked" AutomationProperties.Name="检查更新视图" />
                <RadioButton x:Name="HistoryTab" GroupName="UpdatesView" Content="历史日志"
                             Style="{StaticResource ViewTabStyle}" Checked="ViewTab_Checked"
                             AutomationProperties.Name="历史日志视图" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid x:Name="UpdateView">
                <ScrollViewer x:Name="UpdateScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="更新检查内容">
                    <StackPanel>
                        <Border Background="{StaticResource PanelSurface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" AutomationProperties.Name="更新状态" />
                                <TextBlock x:Name="ReleaseVersionText" Margin="0,7,0,0" FontSize="12"
                                           Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReleaseSizeText" Margin="0,3,0,0" FontSize="12"
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="2,12,2,2">
                            <CheckBox x:Name="AutomaticCheckBox"
                                      Content="启动时自动检查并下载可用更新" IsChecked="True"
                                      Checked="AutomaticCheckBox_Changed" Unchecked="AutomaticCheckBox_Changed"
                                      AutomationProperties.Name="启动时自动检查并下载可用更新" />
                            <CheckBox x:Name="PrereleaseCheckBox" Margin="0,8,0,0"
                                      Content="接收测试版更新"
                                      Checked="PrereleaseCheckBox_Changed" Unchecked="PrereleaseCheckBox_Changed"
                                      AutomationProperties.Name="接收测试版更新" />
                            <TextBlock Margin="22,3,0,0" FontSize="11"
                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="开启后也会接收测试版；测试版可能包含尚未验证的改动。" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="发布说明" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="ReleaseNotesText" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled" Height="138" MinHeight="88"
                                     Background="{StaticResource RaisedSurface}"
                                     AutomationProperties.Name="发布说明" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,2">
                            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" AutomationProperties.Name="下载进度" />
                            <TextBlock x:Name="ProgressText" Margin="0,5,0,0" FontSize="11"
                                       Foreground="{StaticResource SecondaryText}" Visibility="Collapsed" />
                            <TextBlock Text="安装会断开当前皮肤连接，并在完成后重新打开管理器。皮肤库会保留，重开后需重新应用皮肤。"
                                       Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="HistoryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="历史日志" FontSize="18" FontWeight="SemiBold"
                               Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="随应用安装的版本记录，可离线查看。"
                               Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="历史版本记录">
                    <ItemsControl x:Name="HistoryEntries">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                        Padding="0,12,12,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Version}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Body}" Margin="0,7,0,0"
                                                   FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <StackPanel x:Name="UpdateActions" Orientation="Horizontal">
                <Button x:Name="CancelDownloadButton" Content="取消下载" Margin="0,0,8,0"
                        Click="CancelDownloadButton_Click" Visibility="Collapsed" />
                <Button x:Name="DownloadButton" Content="下载更新" Margin="0,0,8,0"
                        Click="DownloadButton_Click" Visibility="Collapsed" />
                <Button x:Name="CheckButton" Content="检查更新" Margin="0,0,8,0"
                        Click="CheckButton_Click" AutomationProperties.Name="检查更新" />
                <Button x:Name="InstallButton" Content="安装更新" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="InstallButton_Click" Visibility="Collapsed"
                        AutomationProperties.Name="安装更新" />
            </StackPanel>
            <Button x:Name="CloseButton" Content="关闭" Click="CloseButton_Click"
                    AutomationProperties.Name="关闭更新窗口" />
        </StackPanel>
    </Grid>
</Window>
